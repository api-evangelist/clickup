      "item": [
        {
          "id": "21717477-76dc-47b7-8eed-94963b8d05cf",
          "name": "Get access token",
          "request": {
            "name": "Get access token",
            "description": {
              "content": "Exchanges an authorization code for an access token. This is the second step in the OAuth 2.0 authorization code flow. The client ID, client secret, and authorization code must be provided.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The OAuth app client ID."
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<string>",
                  "description": "(Required) The OAuth app client secret."
                },
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>",
                  "description": "(Required) The authorization code received from the authorization step."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
