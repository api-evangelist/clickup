{
  "opencollection": "1.0.0",
  "info": {
    "name": "ClickUp Comments Authorization API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authorization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get authorized user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.clickup.com/api/v2/user",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves information about the currently authenticated user, including their ID, username, email, and profile picture. This endpoint requires a valid access token."
        }
      ]
    }
  ],
  "bundled": true
}